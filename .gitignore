# Stage 3A litter pilot: large data blobs (keep json/md audit records only)
artifacts/litter_dataset/**/antmaze_litter_pilot*.npz
artifacts/litter_dataset/**/*.npz

# Rockfall FULL learner npzs exceed GitHub's 100MB limit -> delivered via Drive
# for Colab. Their sidecars, manifests, audit reports and .sha256 files ARE
# tracked (provenance); the big obs/act arrays are not.
artifacts/rockfall_dataset/full/antmaze_rockfall_full.npz
artifacts/rockfall_dataset/oracle/*.npz
# v2 severity-ablation learner npz (metadata kept; not needed for training)
artifacts/rockfall_v2_dataset/pilot_sev055_ablation/*.npz

# generated diagnostics from the windy sweep (regenerated per run; they
# otherwise block git pull on the GPU node with local-modification conflicts)
artifacts/swamp_windy_failure_bank/verify_anchor_cut.json
artifacts/swamp_windy_failure_bank/critic_fork_margin.json

# Windy-swamp sweep checkpoints pulled back from the rented GPU node (523 MB,
# 27 runs x 6 pkl). Kept locally for re-probing the critic; never committed --
# same policy as the other large learner artifacts above.
artifacts/swamp_windy_checkpoints/

# 10 MB of control-run checkpoints; local re-probing only
artifacts/swamp_windy_bd0_control/checkpoints/
